# ==========================================
# ⚙️ SYSTEM SETTINGS
# ==========================================
ENV_NAME=staging_or_production
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com

# ==========================================
# 🐘 BACKEND (PostgreSQL & Security)
# ==========================================
# รูปแบบ: postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB_NAME]
# ⚠️ host ต้องเป็น ${ENV_NAME}_infra_db เสมอ (ชื่อ service ของ Postgres ใน Swarm)
#    ใน Docker Compose ค่า DATABASE_URL/REDIS_URL ถูก override อัตโนมัติจาก ENV_NAME
#    → แก้แค่ ENV_NAME ด้านบน ระบบชี้ host ตัวใหม่ให้เอง (ค่าในนี้เป็นแค่ fallback/เอกสาร)
#    ถ้ารัน dev ในเครื่อง (ไม่ใช้ Docker) ให้เปลี่ยนเป็น localhost:5432/<db> เอาเอง
DATABASE_URL=postgresql://db_user:db_password@${ENV_NAME}_infra_db:5432/piri_db

POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=piri_db

# สุ่มตัวอักษรเพื่อใช้เป็น Key ของระบบ
API_KEY=your_random_api_key_here
SECRET_KEY=your_random_secret_key_here
SUPER_ADMIN_ID=1234567890

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# ใน Docker Compose ค่านี้ถูก override จาก ENV_NAME เช่นกัน (ดู comment DATABASE_URL ข้างบน)
REDIS_URL=redis://${ENV_NAME}_infra_redis:6379/0

# อีเมลสำหรับแจ้ง certificate Let's Encrypt — ใช้เมื่อเปิด HTTPS ใน docker-compose.proxy.yml
# ACME_EMAIL=admin@yourdomain.com

# Queue Import นักเรียนจาก Excel (ARQ Worker)
# โฟลเดอร์เก็บไฟล์ .xlsx — Docker ใช้ /data/imports (shared volume ระหว่าง backend+worker)
# ถ้ารัน dev ในเครื่อง ใส่เช่น IMPORT_STORAGE_DIR=./backend/data/imports
IMPORT_STORAGE_DIR=/data/imports
IMPORT_FILE_SIZE_LIMIT_MB=10
# แถวสูงสุดต่อไฟล์ (กันไฟล์ยักษ์) + จำนวนแถวต่อ batch + อายุงานค้างที่นาทีที่ worker จะกู้คืน
IMPORT_MAX_ROWS=5000
IMPORT_BATCH_SIZE=50
IMPORT_RECOVERY_STALE_MINUTES=35

# Seed users (admin/ครูสภา/ประธานสภา) ตอนเปิดระบบครั้งแรก
# ไฟล์ที่ระบบจะเขียน username + รหัสผ่านชั่วคราวให้ (gitignored) — ควรเปลี่ยนเป็น path ที่ปลอดภัย
SEED_CREDENTIALS_FILE=./default_admin_credentials.txt

# ==========================================
# 🔔 WEB PUSH (A3)
# ==========================================
# สร้างคีย์ด้วย:  docker compose -f docker-compose.test.yml run --rm test_runner \
#                    python /app/scripts/generate_vapid_keys.py
# (ต้องมี Docker เพราะ `py-vapid` ไม่ได้ติดตั้งบนเครื่อง host)
#
# ⚠️ **เว้นว่าง = ปิด push ทั้งระบบ** (in-app ยังทำงานปกติ) — เป็นสวิตช์ปิดฉุกเฉินที่
#    ไม่ต้อง deploy โค้ดใหม่ แค่ force update service
# ⚠️ **ห้าม commit private key** — ใส่ใน `.env` เท่านั้น (ไฟล์นั้น gitignored อยู่แล้ว)
# ⚠️ **rotate key = subscription เดิมใช้ไม่ได้ทั้งหมด** ต้องลบแถวใน `push_subscriptions`
#    แล้วให้นักเรียนกด "เปิดการแจ้งเตือน" ใหม่ทุกคน
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# `sub` claim ของ VAPID JWT — **ต้องขึ้นต้นด้วย `mailto:`** (RFC 8292 / py-vapid validate)
VAPID_SUBJECT=mailto:admin@example.com
# ปรับได้ตามปริมาณจริง — ดูคำอธิบายใน backend/core/config.py
PUSH_BATCH_SIZE=100
# จังหวะส่งของ worker (วินาที) — ลูปในโปรเซสเอง ไม่พึ่ง ARQ cron (ดู core/config.py)
PUSH_TICK_SECONDS=5.0
# งบเวลาต่อ 1 รอบ — ระบายซ้ำจนคิวว่างหรือหมดงบ (🚨 ต้อง << job_timeout 120 วิ)
PUSH_DRAIN_SECONDS=45.0
PUSH_MAX_ATTEMPTS=5
# ด่านกัน push storm หลัง worker ล่ม — เกินอายุนี้ไม่ส่ง (mark processed ทันที)
PUSH_MAX_AGE_MINUTES=15
# กู้แถวที่ worker ตายกลางคัน — 🚨 ต้องน้อยกว่า PUSH_MAX_AGE_MINUTES เสมอ
# (ถ้าเท่ากัน/มากกว่า แถวที่กู้คืนมาจะถูกทิ้งเป็น stale ทันที = กู้ไม่ได้จริง)
PUSH_RECOVER_MINUTES=5
PUSH_RETENTION_DAYS=7
PUSH_SEND_CONCURRENCY=20
PUSH_TTL_SECONDS=3600
# 🚨 ความเร่งด่วนของ push (RFC 8030) — ค่า: very-low | low | normal | high
# ⚠️ `normal` (หรือไม่ใส่) บน Android = ระบบ *เลื่อน* การส่งได้จนกว่าเครื่องจะตื่น
#    ⇒ อาการคือ "ปิดแอพอยู่ไม่เด้ง พอเปิดแอพเด้งมาทั้งกองเก่า" ซึ่งดูเหมือนแอพพัง
# ⇒ คงไว้ที่ `high` สำหรับระบบแจ้งเตือนโรงเรียน (แลกกับแบตที่กินเพิ่มเล็กน้อย)
PUSH_URGENCY=high

# ==========================================
# 📡 NOTIFICATION STREAM (SSE) — badge ขยับทันทีโดยไม่ต้อง poll
# ==========================================
# ⚠️ คนละเรื่องกับ PUSH_* ข้างบนโดยสิ้นเชิง:
#   PUSH_*   = "ปิดแอพอยู่ก็ยังเด้ง"        (ผ่าน FCM/APNs — มี Doze/คิวของ OS เป็นพื้นทางกายภาพ)
#   STREAM_* = "เปิดแอพอยู่ badge ขยับทันที" (ผ่าน Postgres LISTEN/NOTIFY)
# ⇒ ต้องมีทั้งคู่ ไม่ใช่แทนกัน · ทั้งสามตัวมี default ในโค้ดแล้ว ⇒ ไม่ใส่ก็ทำงานได้
#    (เว้นแต่จะเปลี่ยนชื่อ channel ซึ่งต้องแก้ migration 020 ด้วย — ดูคำเตือนใน config.py)

# ชื่อ Postgres NOTIFY channel — 🚨 ต้องตรงกับ trigger ใน migration 020
# เปลี่ยนที่นี่ที่เดียว = เงียบทั้งระบบโดยไม่มี error (LISTEN ค้างบน channel ที่ไม่มีใครส่งมา)
NOTIFY_CHANNEL=piri_notifications
# ⏱️ ส่ง comment `: ping` ทุกกี่วินาที — **จำเป็น ไม่ใช่ของประดับ**
# Proxy (Traefik/Cloudflare) ตัด connection ที่เงียบได้ตามใจ ⇒ ไม่มี heartbeat = badge ค้างเงียบ ๆ
STREAM_HEARTBEAT_SECONDS=20
# จำนวนผู้ใช้ที่เปิด stream พร้อมกันได้ **ต่อ 1 replica** (backend รัน 3 ตัว ⇒ เพดานจริง = 3 เท่า)
# เกินเพดาน = ตอบ 503 แล้ว client ตกไปใช้ poll 30 วิแทน (ไม่พัง แค่กลับไปช้าเท่าเดิม)
STREAM_MAX_SUBSCRIBERS=2000

# ==========================================
# 🌐 FRONTEND (Vue / Vite)
# ==========================================
VITE_API_BASE_URL=https://api.yourdomain.com
